# Copy as .env and fill in real values (.env is already ignored by .gitignore)
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
API_HOST=0.0.0.0
API_PORT=8081
EXPLORE_INTERVAL_DAYS=10
# Optional: password hash; when left empty, read data/personal_password.hash (not kept in Git)
PERSONAL_PASSWORD_HASH=
SERPER_API_KEY=
